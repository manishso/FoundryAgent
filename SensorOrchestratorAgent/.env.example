# Optional overrides for local runs. Values in appsettings.json are used when these are unset.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=gpt-4.1-mini

# Port Foundry probes; the Dockerfile sets this for the container.
ASPNETCORE_URLS=http://+:8088

# Local only: use az login / Visual Studio credentials and skip the managed identity probe.
AZURE_TOKEN_CREDENTIALS=dev

# APP_CONFIG_PATH=appsettings.Production.json
# SENSOR_API_KEY=...
